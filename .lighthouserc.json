{
  "ci": {
    "collect": {
      "startServerCommand": "PORT=4039 yarn start",
      "startServerReadyPattern": "Listening",
      "url": [
        "http://localhost:4039/",
        "http://localhost:4039/taches",
        "http://localhost:4039/contact",
        "http://localhost:4039/catalogue",
        "http://localhost:4039/catalogue/plantes-interieur",
        "http://localhost:4039/catalogue/plantes-interieur/feuillages",
        "http://localhost:4039/mentions-legales",
        "http://localhost:4039/donnees-personnelles",
        "http://localhost:4039/accessibilite",
        "http://localhost:4039/plan-du-site",
        "http://localhost:4039/blog",
        "http://localhost:4039/blog/le-mode-accessibilite-renforcee",
        "http://localhost:4039/produit/monstera-deliciosa"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
